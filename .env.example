# Copy to .env and adjust. Everything has a sensible default for local dev.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fuel.example.com
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_SECURE_SSL_REDIRECT=1

# Point at self-hosted instances for real traffic; the public ones are rate limited.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
FUEL_PLANNER_USER_AGENT=fuel-route-api/1.0 (you@example.com)

ROUTE_PLAN_RATE=60/min
LOG_LEVEL=INFO
