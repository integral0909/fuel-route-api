    {
      "name": "4. Street address + coordinates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/route-plan/?start=1600 Amphitheatre Parkway, Mountain View, CA&finish=30.2672,-97.7431",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route-plan",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "1600 Amphitheatre Parkway, Mountain View, CA"
            },
            {
              "key": "finish",
              "value": "30.2672,-97.7431"
            }
          ]
        },
        "description": "Street address falls back to Nominatim (2nd external call); lat,lon input needs none."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has fuel stops and total cost\", () => {",
              "  pm.expect(body.summary.total_fuel_cost).to.be.a(\"number\");",
              "  pm.expect(body.fuel_stops).to.be.an(\"array\");",
              "});",
              "pm.test(\"No gap longer than 500 miles between stops\", () => {",
